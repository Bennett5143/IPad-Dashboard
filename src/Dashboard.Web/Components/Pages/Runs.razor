@page "/runs"
@layout DetailLayout
@rendermode InteractiveServer
@inject IRunRepository RunRepository
@inject IRunPlaceStore RunPlaces
@inject IStravaTokenStore TokenStore
@inject NavigationManager Nav

<PageTitle>Läufe</PageTitle>

<PageHeader Title="Läufe" />

<FitnessTabs />

<div class="detail-body is-scroll">
    <div class="runs-page">
    @if (!_connected)
    {
        <p class="runs-msg">Noch nicht mit Strava verbunden – <a href="/strava/connect">jetzt verbinden</a>.</p>
    }
    else if (_allRuns.Count == 0)
    {
        <p class="runs-msg">Noch keine Läufe synchronisiert.</p>
    }
    else
    {
        @if (_review is not null)
        {
            <div class="tab-row" role="group" aria-label="Jahr">
                <div class="tab-row-items">
                    @foreach (var year in _review.AvailableYears)
                    {
                        <button class="tab @(year == _review.Year ? "is-active" : null)" @onclick="() => SetYear(year)">@year</button>
                    }
                </div>
            </div>

            @* Hero: die Jahresdistanz trägt die Seite, die übrigen Kennzahlen ordnen sich rechts an. *@
            <section class="runs-hero">
                <div class="runs-hero-main">
                    <span class="mono-label">DISTANZ @_review.Year</span>
                    <span class="runs-hero-num">@_review.TotalKm</span>
                </div>
                <dl class="review-stats">
                    <div><dt>Läufe</dt><dd>@_review.RunCount</dd></div>
                    <div><dt>Höhenmeter</dt><dd>@_review.TotalElevation</dd></div>
                    <div><dt>Zeit</dt><dd>@_review.TotalTime</dd></div>
                </dl>
            </section>

            <section class="runs-region">

                <Explainable Id="MetricId.RunYearReview"><ChildContent>
                <div class="review-bars" role="img" aria-label="Kilometer pro Monat">
                    @foreach (var month in _review.Months)
                    {
                        <div class="review-bar" title="@month.Label: @month.Km km">
                            <div class="review-bar-track">
                                <div class="review-bar-fill"
                                     style="height: @(month.BarPercent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture))%"></div>
                            </div>
                            <span class="review-bar-label">@month.Label</span>
                        </div>
                    }
                </div>
                </ChildContent></Explainable>

                <dl class="review-records">
                    <div><dt>Längster Lauf</dt><dd>@_review.LongestRun</dd></div>
                    <div><dt>Schnellste Ø-Pace</dt><dd>@_review.FastestPace</dd></div>
                    <div><dt>Stärkster Monat</dt><dd>@_review.BiggestMonth</dd></div>
                </dl>
            </section>
        }

        @if (_places.Count > 0)
        {
            <section class="runs-region routes">
                <h2>Orte</h2>
                <p class="routes-hint">
                    Läufe werden nach ihrem Startpunkt zu Orten gebündelt — egal, wie die Strecke an dem
                    Tag verlief. Einen Ort antippen zeigt seine Läufe auf der Karte; auf den Namen tippen
                    benennt ihn um.
                </p>
                <table class="runs-table">
                    <thead>
                        <tr>
                            <th scope="col">Ort</th>
                            <th scope="col" class="num">Läufe</th>
                            <th scope="col" class="num">Distanz</th>
                            <th scope="col" class="num">Ø Pace</th>
                            <th scope="col" class="num">Letzter Lauf</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var place in _places)
                        {
                            <tr class="runs-row" @onclick="() => OpenPlace(place.Id)">
                                <td class="run-name">
                                    @if (_renaming == place.Id)
                                    {
                                        <input class="place-name-input" value="@place.Name"
                                               @onclick:stopPropagation="true"
                                               @onchange="e => RenameAsync(place.Id, e.Value?.ToString())" />
                                    }
                                    else
                                    {
                                        <button class="place-name" @onclick:stopPropagation="true"
                                                @onclick="() => _renaming = place.Id">@place.Name</button>
                                    }
                                </td>
                                <td class="num mono">@place.Runs</td>
                                <td class="num mono">@place.Distance</td>
                                <td class="num mono pace">@place.Pace</td>
                                <td class="num mono">@place.LastRun</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </section>
        }
    }
    </div>
</div>

@code {
    private bool _connected;
    private IReadOnlyList<Run> _allRuns = [];
    private RunReviewView? _review;
    private IReadOnlyList<RunPlaceRow> _places = [];

    /// <summary>Der Ort, dessen Name gerade bearbeitet wird.</summary>
    private int? _renaming;

    protected override async Task OnInitializedAsync()
    {
        _connected = await TokenStore.HasTokensAsync();
        if (!_connected)
        {
            return;
        }

        // Einmal alle Läufe (Projektion ohne Geometrie) – der Rückblick braucht ohnehin alle Jahre.
        _allRuns = await RunRepository.GetRunSummariesAsync(null);
        var years = RunReviewCalculator.AvailableYears(_allRuns);
        _review = years.Count > 0 ? RunReviewViewBuilder.Build(_allRuns, years[0]) : null;
        _places = RunViewBuilder.BuildRunPlaces(await RunPlaces.GetSummariesAsync());
    }

    private async Task RenameAsync(int placeId, string? name)
    {
        _renaming = null;
        if (string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        await RunPlaces.RenameAsync(placeId, name);
        _places = RunViewBuilder.BuildRunPlaces(await RunPlaces.GetSummariesAsync());
    }

    private void SetYear(int year)
    {
        if (_review is not null && year != _review.Year)
        {
            _review = RunReviewViewBuilder.Build(_allRuns, year);
        }
    }

    // Bewusst OHNE forceLoad: ein voller Seitenaufruf verlässt auf dem Kiosk-iPad das
    // Standalone-Fenster. Die leere Karte, gegen die er einmal half, fängt heatmap.js selbst ab
    // (waitForSize vor dem Init, invalidateSize + fitBounds danach, ResizeObserver dahinter).
    private void OpenPlace(int placeId) => Nav.NavigateTo($"/heatmap?place={placeId}");
}
