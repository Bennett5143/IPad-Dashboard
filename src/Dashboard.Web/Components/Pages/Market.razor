@page "/crypto/market"
@layout DetailLayout
@using Dashboard.Domain.Research
@rendermode InteractiveServer
@inject IResearchRepository Research

@* The market report as the research tooling recorded it: a paragraph on how
   things stand, and the few events several newsletters carried — one at a time,
   arrows and swiping. This page presents no number as its own and adds no
   forecast or recommendation. The quote tables are gone: the prices that matter
   here are on /crypto, live, and repeating them invited two truths. *@

<PageTitle>Marktbericht</PageTitle>

<PageHeader Title="Marktbericht">
    <span class="mono-label" id="@CounterId"></span>
</PageHeader>

@* Ohne diese Zeile führt von hier kein Weg zurück außer über das Rail-Icon. *@
<nav class="tab-row area-subnav" aria-label="Krypto">
    <div class="tab-row-items">
        <a class="tab" href="/crypto">Kurse</a>
        <a class="tab is-active" href="/crypto/market" aria-current="page">Marktbericht</a>
    </div>
</nav>

<div class="detail-body">
    @if (_report is null)
    {
        <p class="rs-empty">Wird geladen…</p>
    }
    else if (!HasContent)
    {
        <p class="rs-empty">
            Kein Marktbericht vorhanden. Das Recherche-Tooling hat für diese
            Datenbank noch nichts geschrieben.
        </p>
    }
    else
    {
        <NewsDeck Items="_deck" CounterElementId="@CounterId" />
    }
</div>

@code {
    private const string CounterId = "market-counter";

    private MarketReport? _report;
    private IReadOnlyList<NewsDeckItem> _deck = [];

    /// <summary>
    /// Was die Seite zeigt, sind Lage und Einträge — die Kurstabellen sind entfallen. Ein Bericht
    /// aus reinen Kursen ist für diese Seite deshalb leer, auch wenn er Zeilen hat.
    /// </summary>
    private bool HasContent => _report is { } report && (report.Situation is not null || report.Events.Count > 0);

    protected override async Task OnInitializedAsync()
    {
        _report = await Research.GetMarketReportAsync();
        _deck = MarketReportViewBuilder.Build(_report);
    }
}
