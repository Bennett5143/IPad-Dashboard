@page "/crypto/market"
@layout DetailLayout
@using Dashboard.Domain.Research
@rendermode InteractiveServer
@inject IResearchRepository Research

@* The market report as the research tooling recorded it: a paragraph on how
   things stand, and the few events several newsletters carried — one at a time,
   arrows and swiping. This page presents no number as its own and adds no
   forecast or recommendation. The quote tables are gone: the prices that matter
   here are on /crypto, live, and repeating them invited two truths. *@

<PageTitle>Marktbericht</PageTitle>

<PageHeader Title="Marktbericht" Meta="@Meta">
    <span class="mono-label" id="@CounterId"></span>
</PageHeader>

<div class="detail-body">
    @if (_report is null)
    {
        <p class="rs-empty">Wird geladen…</p>
    }
    else if (!HasContent)
    {
        <p class="rs-empty">
            Kein Marktbericht vorhanden. Das Recherche-Tooling hat für diese
            Datenbank noch nichts geschrieben.
        </p>
    }
    else
    {
        @if (_report.Situation is { } situation)
        {
            <section class="rs-situation-block">
                <h2 class="mono-label">DIE LAGE</h2>
                @if (situation.FiguresFlagged)
                {
                    <p class="rs-disclaimer">
                        Dieser Text gibt eine Zahl wieder, die das Tooling selbst abgerufen hat.
                    </p>
                }
                <p class="rs-situation">@situation.Body</p>
                <p class="rs-source">@CorpusMeta(situation)</p>
            </section>
        }

        @if (_report.Events.Count > 0)
        {
            <h2 class="mono-label rs-deck-heading">BEMERKENSWERT</h2>
            <NewsDeck Items="_deck" CounterElementId="@CounterId" />
        }
    }
</div>

@code {
    private const string CounterId = "market-counter";

    private MarketReport? _report;
    private IReadOnlyList<NewsDeckItem> _deck = [];

    /// <summary>
    /// Was die Seite zeigt, sind Lage und Einträge — die Kurstabellen sind entfallen. Ein Bericht
    /// aus reinen Kursen ist für diese Seite deshalb leer, auch wenn er Zeilen hat.
    /// </summary>
    private bool HasContent => _report is { } report && (report.Situation is not null || report.Events.Count > 0);

    private string? Meta => _report?.LastUpdated is { } stamp
        ? $"STAND {stamp.ToLocalTime():dd.MM. HH:mm}"
        : null;

    protected override async Task OnInitializedAsync()
    {
        _report = await Research.GetMarketReportAsync();
        _deck = MarketReportViewBuilder.Build(_report);
    }

    /// <summary>
    /// Which issues the paragraph was drawn from. It carries no single date —
    /// it is written from a whole window — so the window is what makes its age
    /// visible.
    /// </summary>
    private static string CorpusMeta(MarketSituation situation)
    {
        var parts = new List<string>();
        if (situation.IssueCount > 0)
        {
            parts.Add($"{situation.IssueCount} Ausgaben");
        }

        if (situation.NewsletterCount > 0)
        {
            parts.Add($"{situation.NewsletterCount} Newsletter");
        }

        if (situation is { CorpusFrom: { } from, CorpusTo: { } to })
        {
            parts.Add(from == to
                ? from.ToString("dd.MM.yyyy")
                : $"{from:dd.MM.} – {to:dd.MM.yyyy}");
        }

        return parts.Count == 0 ? "" : "Aus " + string.Join(", ", parts);
    }
}
