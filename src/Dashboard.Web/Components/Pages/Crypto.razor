@page "/crypto"
@layout DetailLayout
@implements IDisposable
@inject CryptoState CryptoState
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Krypto</PageTitle>

<PageHeader Title="Krypto" />

<div class="tab-row" role="navigation">
    <div class="tab-row-items">
        <span class="tab is-active">Kurse</span>
        @* Written by the research tooling into the `research` schema. *@
        <a class="tab" href="/crypto/market">Marktbericht</a>
    </div>
</div>

@* is-scroll: die vollständige Watchlist plus eine aufgeklappte Zeile geht bewusst über 768 px. *@
<div class="detail-body is-scroll">
    @if (_snapshot is null)
    {
        <p class="crypto-empty">Krypto-Daten gerade nicht verfügbar.</p>
    }
    else
    {
        @if (_snapshot.Sentiment is { } sentiment)
        {
            <section class="fng">
                <div class="fng-score">
                    <span class="fng-num">@sentiment.Value</span>
                    <span class="mono-label">FEAR &amp; GREED</span>
                </div>
                <div class="fng-body">
                    <span class="fng-class">@sentiment.Classification</span>
                    <div class="fng-bar" role="img" aria-label="Fear and Greed Index @sentiment.Value von 100">
                        <div class="fng-fill" style="width:@(sentiment.Value)%"></div>
                    </div>
                    <div class="fng-scale">
                        <span>ANGST</span><span>NEUTRAL</span><span>GIER</span>
                    </div>
                </div>
            </section>
        }

        @if (_snapshot.Coins.Count > 0)
        {
            <section class="coins">
                <div class="coin-head">
                    <span>COIN</span>
                    <span class="r">PREIS</span>
                    <span class="r">24 H</span>
                    <span class="r">7 TAGE</span>
                </div>
                @foreach (var c in _snapshot.Coins)
                {
                    var up = c.Change24hPct >= 0;
                    var tag = c.Symbol.Length <= 3 ? c.Symbol : c.Symbol[..3];
                    var expanded = _expanded == c.Id;

                    <div class="coin-row @(expanded ? "is-expanded" : null)" role="button" tabindex="0"
                         aria-expanded="@expanded" @onclick="() => Toggle(c.Id)">
                        <span class="coin-id">
                            @if (ImageProxy.Src(c.ImageUrl) is { } logo)
                            {
                                <img class="coin-logo" src="@logo" alt="" width="24" height="24" loading="lazy" />
                            }
                            else
                            {
                                <span class="chip coin-chip">@tag</span>
                            }
                            <span class="coin-names">
                                <span class="coin-sym">@c.Symbol</span>
                                <span class="coin-name">@c.Name</span>
                            </span>
                        </span>
                        <span class="r coin-price">@CryptoFormatter.Price(c.Price)</span>
                        <span class="r">
                            <span class="coin-chg @(up ? "up" : "down")">@CryptoFormatter.Percent(c.Change24hPct)</span>
                        </span>
                        <span class="r">
                            <Sparkline Values="c.Sparkline7d"
                                       CssClass="@($"coin-spark {(up ? "coin-spark--up" : "coin-spark--down")}")" />
                        </span>
                    </div>

                    @if (expanded)
                    {
                        <div class="coin-detail">
                            <ChartFrame CssClass="coin-detail-chart"
                                        XLabel="Sieben Tage" YLabel="Kurs ($)"
                                        RangeStart="@Low(c)" RangeEnd="@High(c)">
                                <Sparkline Values="c.Sparkline7d" Fill="true"
                                           CssClass="@(up ? "coin-spark--up" : "coin-spark--down")" />
                            </ChartFrame>
                            <button class="coin-detail-link" @onclick:stopPropagation="true"
                                    @onclick="() => OpenDetail(c.Id)">
                                Details · Stunde bis Jahr ›
                            </button>
                        </div>
                    }
                }
            </section>
        }
        else
        {
            <p class="crypto-empty">Keine Coins konfiguriert.</p>
        }
    }
</div>

@code {
    private CryptoSnapshot? _snapshot;

    /// <summary>Die eine offene Zeile; <c>null</c> = alle zu.</summary>
    private string? _expanded;

    protected override void OnInitialized()
    {
        CryptoState.Changed += OnChanged;
        ReadState();
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        ReadState();
        StateHasChanged();
    });

    private void ReadState()
    {
        _snapshot = CryptoState.Current;
    }

    /// <summary>Höchstens eine Zeile ist offen — zwei Charts nebeneinander hätten keinen Platz.</summary>
    private void Toggle(string coinId) => _expanded = _expanded == coinId ? null : coinId;

    private void OpenDetail(string coinId) => Nav.NavigateTo($"/crypto/{coinId}");

    private static string? Low(CoinQuote coin) => Extreme(coin, lowest: true);

    private static string? High(CoinQuote coin) => Extreme(coin, lowest: false);

    // Die Achsen-Eckwerte kommen aus der 7-Tage-Reihe, die die Watchlist ohnehin mitbringt —
    // ein zusätzlicher Abruf nur fürs Minimum wäre verschwendet.
    private static string? Extreme(CoinQuote coin, bool lowest)
    {
        var values = coin.Sparkline7d.OfType<double>().ToList();
        if (values.Count == 0)
        {
            return null;
        }

        return CryptoFormatter.Price((decimal)(lowest ? values.Min() : values.Max()));
    }

    public void Dispose() => CryptoState.Changed -= OnChanged;
}
