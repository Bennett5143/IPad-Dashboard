@page "/crypto"
@layout DetailLayout
@implements IDisposable
@using Dashboard.Domain.Crypto
@inject CryptoState CryptoState
@inject ICoinHistoryProvider History
@inject ILogger<Crypto> Log
@rendermode InteractiveServer

<PageTitle>Krypto</PageTitle>

<PageHeader Title="Krypto" />

@* .area-subnav trägt denselben Innenabstand wie auf /crypto/market — ohne die Klasse stand die
   Zeile hier bündig am Rand und sprang beim Seitenwechsel um 28px. *@
<nav class="tab-row area-subnav" aria-label="Krypto">
    <div class="tab-row-items">
        <a class="tab is-active" href="/crypto" aria-current="page">Kurse</a>
        @* Written by the research tooling into the `research` schema. *@
        <a class="tab" href="/crypto/market">Marktbericht</a>
    </div>
</nav>

@* is-scroll: die vollständige Watchlist plus eine aufgeklappte Zeile geht bewusst über 768 px. *@
<div class="detail-body is-scroll">
    @if (_snapshot is null)
    {
        <p class="crypto-empty">Krypto-Daten gerade nicht verfügbar.</p>
    }
    else
    {
        @if (_snapshot.Sentiment is { } sentiment)
        {
            <section class="fng">
                <div class="fng-score">
                    <span class="fng-num">@sentiment.Value</span>
                    <span class="mono-label">FEAR &amp; GREED</span>
                </div>
                <div class="fng-body">
                    <span class="fng-class">@sentiment.Classification</span>
                    <div class="fng-bar" role="img" aria-label="Fear and Greed Index @sentiment.Value von 100">
                        <div class="fng-fill" style="width:@(sentiment.Value)%"></div>
                    </div>
                    <div class="fng-scale">
                        <span>ANGST</span><span>NEUTRAL</span><span>GIER</span>
                    </div>
                </div>
            </section>
        }

        @if (_snapshot.Coins.Count > 0)
        {
            <section class="coins">
                <div class="coin-head">
                    <span>COIN</span>
                    <span class="r">PREIS</span>
                    <span class="r">24 H</span>
                    <span class="r">7 TAGE</span>
                </div>
                @foreach (var c in _snapshot.Coins)
                {
                    var up = c.Change24hPct >= 0;
                    var tag = c.Symbol.Length <= 3 ? c.Symbol : c.Symbol[..3];

                    <div class="coin-row" role="button" tabindex="0" aria-haspopup="dialog"
                         @onclick="() => OpenAsync(c)" @onkeydown="e => OnRowKeyAsync(e, c)">
                        <span class="coin-id">
                            @if (ImageProxy.Src(c.ImageUrl) is { } logo)
                            {
                                <img class="coin-logo" src="@logo" alt="" width="24" height="24" loading="lazy" />
                            }
                            else
                            {
                                <span class="chip coin-chip">@tag</span>
                            }
                            <span class="coin-names">
                                <span class="coin-sym">@c.Symbol</span>
                                <span class="coin-name">@c.Name</span>
                            </span>
                        </span>
                        <span class="r coin-price">@CryptoFormatter.Price(c.Price)</span>
                        <span class="r">
                            <span class="coin-chg @(up ? "up" : "down")">@CryptoFormatter.Percent(c.Change24hPct)</span>
                        </span>
                        <span class="r">
                            <Sparkline Values="c.Sparkline7d"
                                       CssClass="@($"coin-spark {(up ? "coin-spark--up" : "coin-spark--down")}")" />
                        </span>
                    </div>
                }
            </section>
        }
        else
        {
            <p class="crypto-empty">Keine Coins konfiguriert.</p>
        }
    }
</div>

@* Eine Geste, eine Fläche: der Verlauf liegt über der Liste statt in einer aufklappenden Zeile
   und einer eigenen Seite. Zwei Wege in dasselbe Diagramm hätten sonst unterschiedlich viel
   gekonnt — und die aufgeklappte Zeile war das, was die Liste über den Bildschirm schob. *@
@if (_open is { } coin)
{
    <div class="dialog-backdrop" @onclick="Close">
        @* tabindex/@ref, damit der Fokus beim Öffnen hierher wandert und Escape ankommt — sonst
           bliebe das Fenster nur mit der Maus schließbar. *@
        <div class="dialog coin-dialog" role="dialog" aria-modal="true" aria-label="@coin.Name"
             tabindex="-1" @ref="_dialog" @onkeydown="OnDialogKey" @onclick:stopPropagation="true">
            <header class="coin-dialog-head">
                @if (ImageProxy.Src(coin.ImageUrl) is { } logo)
                {
                    <img class="coin-logo" src="@logo" alt="" width="28" height="28" />
                }
                <span class="coin-dialog-sym">@coin.Symbol</span>
                <span class="coin-dialog-name">@coin.Name</span>
                <span class="coin-dialog-price">@CryptoFormatter.Price(coin.Price)</span>
                <span class="coin-dialog-chg @(coin.Change24hPct >= 0 ? "up" : "down")">
                    @CryptoFormatter.Percent(coin.Change24hPct)
                </span>
                <button class="coin-dialog-close" @onclick="Close" aria-label="Schließen">×</button>
            </header>

            <div class="coin-dialog-body">
                @if (_loading)
                {
                    <p class="crypto-empty">Wird geladen…</p>
                }
                else if (_history is { HasPoints: true } history)
                {
                    <ChartFrame CssClass="coin-dialog-chart"
                                YMax="@CryptoFormatter.Price(history.Maximum)"
                                YMid="@CryptoFormatter.Price((history.Minimum + history.Maximum) / 2)"
                                YMin="@CryptoFormatter.Price(history.Minimum)"
                                XTicks="@TimeTicks(history)">
                        <Sparkline Values="@Values(history)" Fill="true" Smooth="true" />
                    </ChartFrame>
                }
                else
                {
                    <p class="crypto-empty">Chart gerade nicht verfügbar.</p>
                }
            </div>

            <div class="tab-row coin-dialog-ranges" role="group" aria-label="Zeitraum">
                <div class="tab-row-items">
                    @foreach (var (range, label) in Ranges)
                    {
                        <button class="tab @(_range == range ? "is-active" : null)"
                                aria-pressed="@(_range == range)" @onclick="() => SelectAsync(range)">
                            @label
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly TimeZoneInfo BerlinTz = TimeZoneInfo.FindSystemTimeZoneById("Europe/Berlin");

    private static readonly (CoinRange Range, string Label)[] Ranges =
    [
        (CoinRange.Hour, "Stunde"),
        (CoinRange.Day, "Tag"),
        (CoinRange.Week, "Woche"),
        (CoinRange.Month, "Monat"),
        (CoinRange.Year, "Jahr"),
    ];

    /// <summary>Vier Marken lesen sich auf der Modal-Breite noch sauber.</summary>
    private const int ChartTicks = 4;

    private CryptoSnapshot? _snapshot;

    /// <summary>Der Coin im Popup; <c>null</c> = zu.</summary>
    private CoinQuote? _open;

    private CoinRange _range = CoinRange.Day;
    private CoinHistory? _history;
    private bool _loading;

    /// <summary>
    /// Zählt die Abrufe. Ein überholter Abruf — anderer Zeitraum, anderer Coin, Fenster zu —
    /// darf das Ergebnis des aktuellen nicht überschreiben, wenn er später zurückkommt.
    /// </summary>
    private int _requestId;

    private ElementReference _dialog;
    private bool _focusDialog;

    protected override void OnInitialized()
    {
        CryptoState.Changed += OnChanged;
        ReadState();
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        ReadState();
        StateHasChanged();
    });

    private void ReadState()
    {
        _snapshot = CryptoState.Current;
    }

    private async Task OpenAsync(CoinQuote coin)
    {
        _open = coin;
        _range = CoinRange.Day;
        _focusDialog = true;
        await LoadAsync();
    }

    private async Task OnRowKeyAsync(KeyboardEventArgs args, CoinQuote coin)
    {
        // Die Zeile ist als role="button" ausgezeichnet, also muss sie sich auch wie einer
        // bedienen lassen: Enter und Leertaste öffnen.
        if (args.Key is "Enter" or " ")
        {
            await OpenAsync(coin);
        }
    }

    private void OnDialogKey(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            Close();
        }
    }

    // Der Zähler steigt auch beim Schließen: ein noch laufender Abruf hat danach niemanden mehr.
    private void Close()
    {
        _requestId++;
        _loading = false;
        _open = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusDialog)
        {
            return;
        }

        _focusDialog = false;
        await _dialog.FocusAsync();
    }

    private async Task SelectAsync(CoinRange range)
    {
        if (range == _range)
        {
            return;
        }

        _range = range;
        await LoadAsync();
    }

    // Geholt wird erst, wenn jemand hinsieht — elf Coins mal fünf Zeiträume im Hintergrund würden
    // die kostenlose Quelle dauerhaft belasten. Der Cache je Zeitraum sitzt im Provider, ein
    // zweites Öffnen desselben Fensters löst also keinen zweiten Abruf aus.
    private async Task LoadAsync()
    {
        if (_open is not { } coin)
        {
            return;
        }

        var request = ++_requestId;
        _loading = true;
        _history = null;

        try
        {
            var history = await History.GetHistoryAsync(coin.Id, _range);
            if (request == _requestId)
            {
                _history = history;
            }
        }
        catch (Exception ex)
        {
            // Ein toter Abruf kostet das Diagramm, nicht die Seite — und schon gar nicht ein
            // Fenster, das für immer „Wird geladen…" zeigt.
            Log.LogWarning(ex, "Kursverlauf {Coin}/{Range} nicht abrufbar.", coin.Id, _range);
        }
        finally
        {
            if (request == _requestId)
            {
                _loading = false;
            }
        }
    }

    private static IReadOnlyList<double?> Values(CoinHistory history) =>
        history.Points.Select(point => (double?)point.Price).ToList();

    /// <summary>
    /// Zeitmarken über das Fenster, auf der Position interpoliert statt aus dem nächsten Messpunkt
    /// genommen: eine Achsenmarke benennt eine Stelle der Achse. Uhrzeiten für Stunde und Tag,
    /// Datum darüber — „14:30" sagt über ein Jahr nichts.
    /// </summary>
    private static IReadOnlyList<string> TimeTicks(CoinHistory history)
    {
        var format = history.Range is CoinRange.Hour or CoinRange.Day ? "HH:mm" : "dd.MM.";
        var de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");
        var from = history.From;
        var span = history.To - from;

        return Enumerable.Range(0, ChartTicks)
            .Select(i => TimeZoneInfo.ConvertTime(from.Add(span * i / (ChartTicks - 1)), BerlinTz)
                .ToString(format, de))
            .ToList();
    }

    public void Dispose() => CryptoState.Changed -= OnChanged;
}
