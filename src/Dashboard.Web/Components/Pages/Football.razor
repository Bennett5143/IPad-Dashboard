@page "/football"
@layout DetailLayout
@implements IDisposable
@inject FootballState FootballState
@rendermode InteractiveServer

<PageTitle>Fußball</PageTitle>

<PageHeader Title="Fußball" />

@* Zwischen Kopf und Body, mit allen Einträgen in einer linksbündigen Gruppe — dieselbe Zeile wie
   auf /football/news. Vorher war „Nachrichten" ein direktes Kind der space-between-Zeile und wurde
   damit an den rechten Rand gedrückt; derselbe Tab sprang beim Seitenwechsel quer über den Kopf. *@
<nav class="tab-row area-subnav" role="tablist" aria-label="Fußball">
    <div class="tab-row-items">
        @foreach (var (key, label) in Tabs())
        {
            <button class="tab @(_tab == key ? "is-active" : null)"
                    role="tab" aria-selected="@(_tab == key)" @onclick="() => _tab = key">
                @label
            </button>
        }
        @* The news subpage is fed by the research tooling, not by football-data. *@
        <a class="tab fb-toggle" href="/football/news">Nachrichten</a>
    </div>
</nav>

<div class="detail-body">
    <div class="fb-body">
        <div class="fb-main">
            @if (_tab == "tables")
            {
                @if (_tables is { Count: > 0 })
                {
                    <TableFilter Tables="_tables" MarkRelegation="true" />
                }
                else
                {
                    <p class="fb-empty">Tabellen gerade nicht verfügbar.</p>
                }
            }
            else if (_tab == "cl" && _cl is not null)
            {
                @* Ligaphase UND Baum untereinander sprengten die Seitenhöhe, und die Tabelle war das,
                   was unten abfiel. Zweite Ebene, eine Ansicht zur Zeit — mit denselben Pills wie
                   die Liga-Auswahl, also ohne neues Vokabular. *@
                @if (ClPhase is not null && _cl.Bracket is not null)
                {
                    <div class="table-filter-pills" role="tablist">
                        <button class="table-pill @(ClShowsKnockout ? null : "is-active")"
                                role="tab" aria-selected="@(!ClShowsKnockout)"
                                @onclick='() => _clView = "phase"'>Ligaphase</button>
                        <button class="table-pill @(ClShowsKnockout ? "is-active" : null)"
                                role="tab" aria-selected="@ClShowsKnockout"
                                @onclick='() => _clView = "knockout"'>K.o.-Runde</button>
                    </div>
                }

                @if (!ClShowsKnockout && ClPhase is { } phase)
                {
                    <TableFilter Tables="@(new[] { phase })" />
                }
                else if (_cl.Bracket is not null)
                {
                    <section class="fb-bracket">
                        <KnockoutBracketView Bracket="_cl.Bracket" />
                    </section>
                }
            }
            else if (_tab.StartsWith("t:", StringComparison.Ordinal) && CurrentTournament() is { } tournament)
            {
                @if (tournament.Groups.Count > 0)
                {
                    <TableFilter Tables="tournament.Groups" />
                }
                @if (tournament.Bracket is not null)
                {
                    <section class="fb-bracket">
                        <h2 class="mono-label">K.O.-RUNDE</h2>
                        <KnockoutBracketView Bracket="tournament.Bracket" />
                    </section>
                }
            }
        </div>

    </div>
</div>

@code {
    private IReadOnlyList<LeagueTable>? _tables;
    private ChampionsLeague? _cl;
    private IReadOnlyList<TournamentView>? _tournaments;
    private string _tab = "tables";

    /// <summary>Mit welchem Tab die Seite öffnet — die Unterseite /football/news verlinkt hierher
    /// zurück und sagt dabei, wohin.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "tab")] public string? TabParameter { get; set; }

    /// <summary>Gewählte CL-Ansicht: <c>null</c> = Vorgabe, sonst „phase" oder „knockout".</summary>
    private string? _clView;

    /// <summary>Die Ligaphase, solange sie Zeilen hat — sonst nichts.</summary>
    private LeagueTable? ClPhase => _cl?.LeaguePhase is { Rows.Count: > 0 } phase ? phase : null;

    /// <summary>
    /// Vorgabe ist die Ligaphase, solange sie Zeilen trägt; danach — in der K.o.-Phase der Saison —
    /// der Baum. Eine getroffene Wahl schlägt die Vorgabe.
    /// </summary>
    private bool ClShowsKnockout => _clView switch
    {
        "knockout" => _cl?.Bracket is not null,
        "phase" => false,
        _ => ClPhase is null && _cl?.Bracket is not null,
    };

    protected override void OnInitialized()
    {
        FootballState.Changed += OnChanged;
        ReadState();
        _tab = DefaultTab();
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        ReadState();
        EnsureValidTab();
        StateHasChanged();
    });

    private void ReadState()
    {
        var snapshot = FootballState.Current;
        _tables = snapshot?.LeagueTables;
        _cl = snapshot?.Cl;
        _tournaments = snapshot?.Tournaments;
    }

    // Tab-Reihenfolge: Tabellen · Champions League · aktive Turniere. Die Vereinssicht entfällt
    // hier ganz — die Woche über alle verfolgten Vereine steht auf der Hauptseite.
    private IReadOnlyList<(string Key, string Label)> Tabs()
    {
        var tabs = new List<(string, string)> { ("tables", "Tabellen") };
        if (_cl is not null)
        {
            tabs.Add(("cl", "Champions League"));
        }

        if (_tournaments is not null)
        {
            tabs.AddRange(_tournaments.Select(t => ($"t:{t.Code}", t.Name)));
        }

        return tabs;
    }

    // Während ein Turnier läuft, ist es die Schlagzeile → als Standard-Tab. Ein ?tab= aus der
    // Rückkehr von /football/news schlägt das, solange es einen Tab benennt, den es gibt.
    private string DefaultTab() =>
        TabParameter is { Length: > 0 } requested && Tabs().Any(t => t.Key == requested)
            ? requested
            : _tournaments is { Count: > 0 } ? $"t:{_tournaments[0].Code}" : "tables";

    private void EnsureValidTab()
    {
        if (!Tabs().Any(t => t.Key == _tab))
        {
            _tab = DefaultTab();
        }
    }

    private TournamentView? CurrentTournament()
    {
        if (_tournaments is null || !_tab.StartsWith("t:", StringComparison.Ordinal))
        {
            return null;
        }

        var code = _tab[2..];
        return _tournaments.FirstOrDefault(t => t.Code == code);
    }

    public void Dispose() => FootballState.Changed -= OnChanged;
}
