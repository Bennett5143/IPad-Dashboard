@page "/weather"
@layout DetailLayout
@implements IDisposable
@inject WeatherState WeatherState
@rendermode InteractiveServer

<PageTitle>Wetter</PageTitle>

<PageHeader Title="Wetter" Meta="@_meta" />

<div class="detail-body">
    @if (_snapshot is null)
    {
        <p class="wx-empty">Wetterdaten gerade nicht verfügbar.</p>
    }
    else
    {
        var current = _snapshot.Current;
        var hourlyTemps = _snapshot.Hourly.Select(h => (double?)h.Temperature).ToList();
        var hours = _snapshot.Hourly.Take(HourColumns).ToList();

        <section class="wx-hero">
            <div class="wx-hero-glyph">
                <WeatherIcon Condition="current.Condition" />
            </div>

            <div class="wx-hero-now">
                <span class="wx-hero-temp">@WeatherFormatter.Temperature(current.Temperature)</span>
                <span class="wx-hero-desc">
                    @current.Description · gefühlt @WeatherFormatter.Temperature(current.FeelsLike)
                </span>
            </div>

            <dl class="wx-facts">
                <div>
                    <dt class="mono-label">MIN/MAX</dt>
                    <dd>@WeatherFormatter.Temperature(_snapshot.Today.MinTemperature) / @WeatherFormatter.Temperature(_snapshot.Today.MaxTemperature)</dd>
                </div>
                <div>
                    <dt class="mono-label">REGEN</dt>
                    <dd>@WeatherFormatter.Precipitation(_snapshot.Today.PrecipitationProbability)</dd>
                </div>
                <div>
                    <dt class="mono-label">WIND</dt>
                    <dd>@WeatherFormatter.Wind(current.WindSpeedMs)</dd>
                </div>
                <div>
                    <dt class="mono-label">SONNENUNTERGANG</dt>
                    <dd>@WeatherFormatter.Sun(current.SunsetUtc)</dd>
                </div>
            </dl>
        </section>

        @* Der Verlauf nimmt die Resthöhe zwischen Hero und Stundenleiste. Die Achsen sagen, was
           die Kurve sonst verschweigt: wie warm es oben ist und welches Fenster sie zeigt. *@
        <div class="wx-trend">
            @* Die Beschriftung gehört zur Kurve, und die zeichnet den ganzen Verlauf — nicht nur
               die Spalten der Leiste darunter. *@
            <ChartFrame XLabel="@TrendWindow(_snapshot.Hourly)" YLabel="Temperatur"
                        YMax="@Extreme(hourlyTemps, highest: true)"
                        YMin="@Extreme(hourlyTemps, highest: false)">
                <Sparkline Values="hourlyTemps" Fill="true" />
            </ChartFrame>
        </div>

        <div class="wx-hours">
            @foreach (var h in hours)
            {
                <div class="wx-hour">
                    <span class="wx-hour-temp">@WeatherFormatter.Temperature(h.Temperature)</span>
                    <span class="wx-hour-time">@($"{h.Time:HH}h")</span>
                    <span class="wx-hour-rain @(h.PrecipitationProbability >= RainThreshold ? "is-wet" : null)">
                        @WeatherFormatter.Precipitation(h.PrecipitationProbability)
                    </span>
                </div>
            }
        </div>

        <div class="wx-outlook">
            @foreach (var day in _snapshot.Outlook)
            {
                <div class="wx-day">
                    <span class="mono-label">@WeatherFormatter.DayLabel(day.Date, _snapshot.Today.Date)</span>
                    <span class="wx-day-text">
                        @day.Description, @WeatherFormatter.Temperature(day.MinTemperature) bis
                        @WeatherFormatter.Temperature(day.MaxTemperature), Regen
                        @WeatherFormatter.Precipitation(day.PrecipitationProbability)
                    </span>
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>Zwölf Spalten füllen die Breite; die Config liefert genau so viele Stunden.</summary>
    private const int HourColumns = 12;

    /// <summary>Ab dieser Regenwahrscheinlichkeit wird die Stunde in Tinte hervorgehoben.</summary>
    private const double RainThreshold = 0.30;

    private WeatherSnapshot? _snapshot;
    private string _meta = "HAMBURG";

    protected override void OnInitialized()
    {
        WeatherState.Changed += OnChanged;
        ReadState();
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        ReadState();
        StateHasChanged();
    });

    /// <summary>Größter bzw. kleinster Wert der Kurve, als Skalenwert der Y-Achse.</summary>
    private static string? Extreme(IReadOnlyList<double?> values, bool highest)
    {
        var present = values.OfType<double>().ToList();
        if (present.Count == 0)
        {
            return null;
        }

        return WeatherFormatter.Temperature(highest ? present.Max() : present.Min());
    }

    /// <summary>
    /// Welches Zeitfenster die Kurve zeigt. Das OWM-Raster liegt bei 3 h je Schritt, zwölf Schritte
    /// reichen also über anderthalb Tage — deshalb steht der Wochentag dabei, sobald das Fenster
    /// den Tag wechselt. „23 – 08 Uhr" allein läse sich wie neun Stunden.
    /// </summary>
    private static string TrendWindow(IReadOnlyList<HourlyForecast> hours)
    {
        if (hours.Count == 0)
        {
            return "Zeit";
        }

        var from = hours[0].Time;
        var to = hours[^1].Time;
        var format = from.Date == to.Date ? "HH" : "ddd HH";
        var de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

        return $"{from.ToString(format, de)} – {to.ToString(format, de)} Uhr";
    }

    private void ReadState()
    {
        _snapshot = WeatherState.Current;
        _meta = _snapshot is null
            ? "HAMBURG"
            : $"HAMBURG · STAND {WeatherFormatter.UpdatedAt(_snapshot.RetrievedAtUtc)}";
    }

    public void Dispose() => WeatherState.Changed -= OnChanged;
}
