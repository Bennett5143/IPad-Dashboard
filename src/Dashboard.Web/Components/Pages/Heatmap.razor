@page "/heatmap"
@layout DetailLayout
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IRunRepository RunRepository
@inject IRunPlaceStore RunPlaces
@inject IStravaTokenStore TokenStore
@inject ISyncStateStore SyncStateStore
@inject IJSRuntime JS

@* Ein Ort zur Zeit, in fester Ansicht. Die Karte lässt sich nicht verschieben und nicht zoomen:
   auf dem offline iPad liegen nur die Kacheln der Orts-Ausschnitte vor, eine bewegliche Karte
   liefe zwangsläufig in graue Flächen. Der Stepper wählt den Ort. *@

<PageTitle>Lauf-Heatmap</PageTitle>

<PageHeader Title="Lauf-Heatmap" />

<FitnessTabs />

<div class="detail-body">
    <div class="heatmap-page">
    @if (!_connected)
    {
        <div class="heatmap-connect">
            <p>Noch nicht mit Strava verbunden. Verbinde dein Konto, um deine Läufe zu synchronisieren.</p>
            <a class="btn-connect" href="/strava/connect">Mit Strava verbinden</a>
        </div>
    }
    else if (_places.Count == 0)
    {
        <p class="heatmap-hint">Noch keine Orte — die Zuordnung läuft mit dem nächsten Sync.</p>
    }
    else
    {
        <div class="heatmap-controls">
            @* Zyklisch: hinter dem letzten Ort kommt der erste. Ein Positionszähler stünde dazu
               im Widerspruch — er suggerierte ein Ende, das es nicht gibt. *@
            <div class="place-stepper">
                <button class="place-step" @onclick="() => StepAsync(-1)"
                        aria-label="Vorheriger Ort">‹</button>
                <span class="place-name">@Current.Name</span>
                <button class="place-step" @onclick="() => StepAsync(1)"
                        aria-label="Nächster Ort">›</button>
            </div>

            <div class="heatmap-stats">
                <div class="stat"><span class="stat-value">@_stats.RunCount</span><span class="stat-label">Läufe</span></div>
                <div class="stat"><span class="stat-value">@_stats.TotalDistanceKm.ToString("0.0", De) km</span><span class="stat-label">Distanz</span></div>
                <div class="stat"><span class="stat-value">@FormatPace(_stats.AveragePaceMinPerKm)</span><span class="stat-label">Ø Pace</span></div>
            </div>
        </div>

        <div class="tab-row" role="group" aria-label="Ebene">
            <div class="tab-row-items">
                <button class="tab @LayerCss("heat")" @onclick='() => SetLayerAsync("heat")'>Heatmap</button>
                <button class="tab @LayerCss("pace")" @onclick='() => SetLayerAsync("pace")'>Pace</button>
                <button class="tab @LayerCss("elevation")" @onclick='() => SetLayerAsync("elevation")'>Höhe</button>
                <button class="tab @LayerCss("direction")" @onclick='() => SetLayerAsync("direction")'>Richtung</button>
                <button class="tab @LayerCss("heartrate")" @onclick='() => SetLayerAsync("heartrate")'>Herzfrequenz</button>
            </div>
        </div>

        <div id="heatmap-map" class="heatmap-map"></div>

        <p class="heatmap-legend">@LegendText</p>
        <p class="sync-info">@SyncInfo</p>
    }
    </div>
</div>

@code {
    private static readonly System.Globalization.CultureInfo De =
        System.Globalization.CultureInfo.GetCultureInfo("de-DE");

    private static readonly TimeZoneInfo BerlinTz =
        TimeZoneInfo.FindSystemTimeZoneById("Europe/Berlin");

    private const string MapElementId = "heatmap-map";

    /// <summary>Ort, mit dem die Seite öffnet (Tap auf /runs).</summary>
    [Parameter, SupplyParameterFromQuery] public int? Place { get; set; }

    private bool _connected;
    private string _layer = "heat";
    private IReadOnlyList<RunPlace> _places = [];
    private int _index;
    private IReadOnlyList<Run> _runs = [];
    private RunStats _stats = new(0, 0, TimeSpan.Zero, null);
    private SyncSnapshot _sync = new(null, null, null);
    private IJSObjectReference? _module;

    private RunPlace Current => _places[Math.Clamp(_index, 0, _places.Count - 1)];

    protected override async Task OnInitializedAsync()
    {
        _connected = await TokenStore.HasTokensAsync();
        _sync = await SyncStateStore.GetAsync();
        if (!_connected)
        {
            return;
        }

        _places = await RunPlaces.GetPlacesAsync();
        if (_places.Count == 0)
        {
            return;
        }

        // Mit ?place= öffnet die Seite auf dem angetippten Ort, sonst auf dem meistgelaufenen.
        var requested = Place is { } id ? _places.ToList().FindIndex(place => place.Id == id) : -1;
        _index = requested >= 0 ? requested : 0;

        await LoadRunsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _connected && _places.Count > 0)
        {
            await RenderMapAsync();

            // Sicherheitsnetz: Der erste Aufbau kann je nach Layout-/Stylesheet-Timing eine leere
            // Karte erzeugen – erst ein zweiter Render rendert zuverlässig.
            await Task.Delay(300);
            try
            {
                await RenderMapAsync();
            }
            catch (JSDisconnectedException)
            {
                // Nutzer hat die Seite inzwischen verlassen – nichts zu tun.
            }
        }
    }

    private async Task LoadRunsAsync()
    {
        var ids = (await RunPlaces.GetRunIdsForPlaceAsync(Current.Id)).ToHashSet();
        var all = await RunRepository.GetRunsAsync(null);

        _runs = all.Where(run => ids.Contains(run.Id)).ToList();
        _stats = RunStatsCalculator.Calculate(_runs);
    }

    /// <summary>
    /// Einen Ort weiter oder zurück, zyklisch: der Modulo holt die Liste an beiden Enden wieder
    /// ein. Bei einem einzigen Ort passiert nichts — dann ist der Nachbar er selbst.
    /// </summary>
    private async Task StepAsync(int offset)
    {
        var next = ((_index + offset) % _places.Count + _places.Count) % _places.Count;
        if (next == _index)
        {
            return;
        }

        _index = next;
        await LoadRunsAsync();
        await RenderMapAsync();
    }

    private async Task RenderMapAsync()
    {
        // Versions-Query bricht den Browser-Cache. An den Prozessstart gekoppelt (AppAssets),
        // damit nach jedem App-Neustart automatisch die aktuelle Datei geladen wird.
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", $"./js/heatmap.js?v={AppAssets.Version}");

        var runs = HeatmapPayloadBuilder.Build(_runs);

        // Der Rahmen ist die Ausdehnung des Ortes — dasselbe Rechteck, dessen Kacheln vorgeladen
        // sind. Damit kann die Ansicht nicht in ungeladene Bereiche zeigen.
        var bounds = Current.Bounds;
        var frame = new
        {
            minLat = bounds.MinLat,
            minLon = bounds.MinLon,
            maxLat = bounds.MaxLat,
            maxLon = bounds.MaxLon,
        };

        await _module.InvokeVoidAsync("render", MapElementId, runs, _layer, frame);
    }

    private async Task SetLayerAsync(string layer)
    {
        if (layer == _layer)
        {
            return;
        }

        _layer = layer;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setLayer", MapElementId, _layer);
        }
    }

    private string LayerCss(string layer) => layer == _layer ? "is-active" : string.Empty;

    private string LegendText => _layer switch
    {
        "pace" => "Heller = schneller",
        "elevation" => "Heller = steiler",
        "direction" => "Lila = bergauf · Grün = bergab",
        "heartrate" => "Blau = niedrig · Rot = hoch",
        _ => "Heller = häufiger gelaufen"
    };

    private static string FormatPace(double? minPerKm)
    {
        if (minPerKm is not { } pace)
        {
            return "–";
        }

        var minutes = (int)pace;
        var seconds = (int)Math.Round((pace - minutes) * 60, MidpointRounding.AwayFromZero);
        if (seconds == 60)
        {
            minutes++;
            seconds = 0;
        }

        return $"{minutes}:{seconds:00} /km";
    }

    private string SyncInfo => _sync.LastSuccessfulSyncUtc is { } last
        ? $"Letzter Sync: {TimeZoneInfo.ConvertTime(last, BerlinTz):dd.MM.yyyy HH:mm}"
            + (_sync.LastError is null ? string.Empty : " · letzter Versuch fehlgeschlagen")
        : "Noch kein erfolgreicher Sync.";

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", MapElementId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Circuit bereits getrennt – nichts zu tun.
            }
        }
    }
}
