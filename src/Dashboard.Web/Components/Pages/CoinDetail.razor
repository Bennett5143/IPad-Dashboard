@page "/crypto/{CoinId}"
@layout DetailLayout
@implements IDisposable
@inject CryptoState CryptoState
@inject ICoinHistoryProvider History
@rendermode InteractiveServer

@* Ein Coin über fünf Zeiträume. Geholt wird erst, wenn jemand hinsieht — elf Coins mal fünf
   Zeiträume im Hintergrund würden die kostenlose Quelle dauerhaft belasten.
   Die Route steht neben /crypto/market; das feste Segment gewinnt gegen den Parameter. *@

<PageTitle>@(Quote?.Name ?? CoinId)</PageTitle>

<PageHeader Title="@(Quote?.Name ?? CoinId)" Meta="@Meta" />

<div class="tab-row" role="group" aria-label="Zeitraum">
    <div class="tab-row-items">
        @foreach (var (range, label) in Ranges)
        {
            <button class="tab @(_range == range ? "is-active" : null)"
                    aria-pressed="@(_range == range)" @onclick="() => SelectAsync(range)">
                @label
            </button>
        }
    </div>
</div>

<div class="detail-body">
    @if (CryptoState.Current is null)
    {
        <p class="crypto-empty">Krypto-Daten gerade nicht verfügbar.</p>
    }
    else if (Quote is null)
    {
        @* Erst mit vorhandenem Snapshot lässt sich sagen, dass der Coin nicht dazugehört —
           vorher wüsste die Seite es nicht besser. *@
        <p class="crypto-empty">Diesen Coin führt die Watchlist nicht.</p>
    }
    else
    {
        @if (Quote is { } quote)
        {
            <section class="coin-hero">
                <span class="coin-hero-price">@CryptoFormatter.Price(quote.Price)</span>
                <span class="coin-hero-change @(quote.Change24hPct >= 0 ? "up" : "down")">
                    @CryptoFormatter.Percent(quote.Change24hPct) · 24 h
                </span>
                <span class="mono-label">@quote.Symbol</span>
            </section>
        }

        <div class="coin-chart">
            @if (_loading)
            {
                <p class="crypto-empty">Wird geladen…</p>
            }
            else if (_history is { HasPoints: true } history)
            {
                <ChartFrame CssClass="coin-chart-frame"
                            XLabel="@RangeLabel(_range)" YLabel="Kurs ($)"
                            RangeStart="@CryptoFormatter.Price(history.Minimum)"
                            RangeEnd="@CryptoFormatter.Price(history.Maximum)">
                    <Sparkline Values="@Values(history)" Fill="true" />
                </ChartFrame>
                <span class="mono-label coin-chart-span">@Span(history)</span>
            }
            else
            {
                <p class="crypto-empty">Chart gerade nicht verfügbar.</p>
            }
        </div>
    }
</div>

@code {
    private static readonly TimeZoneInfo BerlinTz = TimeZoneInfo.FindSystemTimeZoneById("Europe/Berlin");

    private static readonly (CoinRange Range, string Label)[] Ranges =
    [
        (CoinRange.Hour, "Stunde"),
        (CoinRange.Day, "Tag"),
        (CoinRange.Week, "Woche"),
        (CoinRange.Month, "Monat"),
        (CoinRange.Year, "Jahr"),
    ];

    [Parameter] public string CoinId { get; set; } = string.Empty;

    private CoinRange _range = CoinRange.Day;
    private CoinHistory? _history;
    private bool _loading;

    private CoinQuote? Quote => CryptoState.Current?.Coins
        .FirstOrDefault(coin => string.Equals(coin.Id, CoinId, StringComparison.OrdinalIgnoreCase));

    private string? Meta => Quote is null ? null : $"USD · {Quote.Symbol} · COINGECKO";

    protected override void OnInitialized() => CryptoState.Changed += OnChanged;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task SelectAsync(CoinRange range)
    {
        if (range == _range)
        {
            return;
        }

        _range = range;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _history = await History.GetHistoryAsync(CoinId, _range);
        _loading = false;
    }

    private static IReadOnlyList<double?> Values(CoinHistory history) =>
        history.Points.Select(point => (double?)point.Price).ToList();

    private static string RangeLabel(CoinRange range) => range switch
    {
        CoinRange.Hour => "Letzte Stunde",
        CoinRange.Day => "Letzter Tag",
        CoinRange.Week => "Letzte Woche",
        CoinRange.Month => "Letzter Monat",
        _ => "Letztes Jahr",
    };

    private static string Span(CoinHistory history)
    {
        var format = history.Range is CoinRange.Hour or CoinRange.Day ? "HH:mm" : "dd.MM.";
        var de = System.Globalization.CultureInfo.GetCultureInfo("de-DE");

        return $"{Local(history.From).ToString(format, de)} – {Local(history.To).ToString(format, de)}";
    }

    private static DateTimeOffset Local(DateTimeOffset utc) => TimeZoneInfo.ConvertTime(utc, BerlinTz);

    public void Dispose() => CryptoState.Changed -= OnChanged;
}
