@page "/football/news"
@layout DetailLayout
@using Dashboard.Domain.Research
@rendermode InteractiveServer
@inject IResearchRepository Research

@* Football news written by the research tooling. This page only reads: the rows
   belong to the `research` schema, which another repository owns and migrates.
   One item at a time — arrows and swiping; no links, because the display context
   has no internet to open them with. *@

<PageTitle>Fußball-Nachrichten</PageTitle>

<PageHeader Title="Nachrichten" Meta="@Meta">
    <span class="mono-label" id="@CounterId"></span>
</PageHeader>

<div class="detail-body">
    @if (_items is null)
    {
        <p class="rs-empty">Wird geladen…</p>
    }
    else
    {
        <NewsDeck Items="_deck" CounterElementId="@CounterId">
            <EmptyContent>
                <p class="rs-empty">
                    Keine Meldungen vorhanden. Das Recherche-Tooling hat für diese
                    Datenbank noch nichts geschrieben.
                </p>
            </EmptyContent>
        </NewsDeck>
    }
</div>

@code {
    private const string CounterId = "news-counter";

    private IReadOnlyList<FootballNewsItem>? _items;
    private IReadOnlyList<NewsDeckItem> _deck = [];

    private string? Meta => _items is { Count: > 0 }
        ? $"STAND {_items.Max(item => item.LastSeenAt).ToLocalTime():dd.MM. HH:mm}"
        : null;

    protected override async Task OnInitializedAsync()
    {
        _items = await Research.GetFootballNewsAsync();
        _deck = FootballNewsViewBuilder.Build(_items);
    }
}
