@inject Dashboard.Domain.Time.IClock Clock
@inject IConfiguration Configuration
<!DOCTYPE html>
<html lang="de" data-theme="@_theme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, user-scalable=no" />
    <meta name="color-scheme" content="@(_night ? "dark" : "light")" />
    <meta name="theme-color" content="@(_night ? "#121210" : "#f5f2eb")" />
    <base href="/" />
    <ResourcePreloader />
    @* Command-Center-Typografie: Space Grotesk (Text/Kennzahlen) + JetBrains Mono
       (Labels/Zeiten). Fällt ohne Netz sauber auf die System-Schrift zurück. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Dashboard.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    @* Kiosk: „Zum Home-Bildschirm" öffnet die Seite als Standalone-Web-App im
       Vollbild (ohne Safari-Leisten); Status-Bar transparent über dem Papier-Grund.

       Bis hierher gab es nur die Apple-Meta-Tags und gar kein Manifest. Das Manifest
       sagt zweierlei: `display: standalone` ist der Darstellungsmodus (Vollbild ohne
       Browser-Leisten) — dieselbe Aussage wie apple-mobile-web-app-capable, nur im
       Standard —, und `scope` zieht die Grenze, innerhalb derer eine Navigation als
       „noch in der App" gilt. Der Scope steht explizit da, obwohl `start_url: "/"`
       denselben Default ergäbe: die Grenze ist hier der Punkt, um den es geht, und
       explizit ist sie nicht vom Default abhängig.
       Achtung beim Prüfen: iOS liest das Manifest beim Anlegen des Icons und merkt
       es sich, ein bestehendes Icon muss also neu angelegt werden. *@
    @* Die Dev-Instanz auf dem Pi läuft neben der produktiven — beide landen als Icon auf
       demselben Home-Bildschirm. Sie trägt deshalb ein eigenes Wappen (eine Kachel in Akzent)
       und einen eigenen Namen; sonst sind die beiden Icons nicht auseinanderzuhalten. *@
    <link rel="manifest" href="@(_dev ? "site-dev.webmanifest" : "site.webmanifest")" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="@(_dev ? "Dashboard dev" : "Dashboard")" />
    <link rel="apple-touch-icon" href="@(_dev ? "apple-touch-icon-dev.png" : "apple-touch-icon.png")" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    @* Day/night by the wall clock (night 20:00–08:00). Pure JS — no Blazor circuit —
       so the kiosk flips on its own device time and nothing here can fault interactivity.
       App.razor sets the initial data-theme server-side above, so there is no flash. *@
    <script>
        (function () {
            function apply() {
                var h = new Date().getHours();
                var night = h >= 20 || h < 8;
                var root = document.documentElement;
                root.setAttribute('data-theme', night ? 'night' : 'eink');
                root.style.colorScheme = night ? 'dark' : 'light';
            }
            apply();
            setInterval(apply, 60000);
        })();
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private static readonly TimeZoneInfo BerlinTz =
        TimeZoneInfo.FindSystemTimeZoneById("Europe/Berlin");

    // Server-computed initial theme so the first paint is already day/night (no flash);
    // the inline script above keeps a running kiosk in sync on the device clock.
    private string _theme = ThemeResolver.Day;
    private bool _night;

    /// <summary>
    /// Läuft diese Instanz als Dev-Stack neben der produktiven? Gesetzt in
    /// <c>docker-compose.dev.yml</c> (<c>Kiosk__Instance=dev</c>); steuert ausschließlich
    /// Home-Bildschirm-Icon und App-Name, damit die beiden Icons unterscheidbar sind.
    /// </summary>
    private bool _dev;

    protected override void OnInitialized()
    {
        _theme = ThemeResolver.Resolve(Clock.UtcNow, BerlinTz);
        _night = _theme == ThemeResolver.Night;
        _dev = string.Equals(Configuration["Kiosk:Instance"], "dev", StringComparison.OrdinalIgnoreCase);
    }
}
