@inherits LayoutComponentBase

@* Schlichter Shell für frei scrollende Seiten (Lauf-Detail, NotFound, Admin):
   Inhalt mittig begrenzt, Höhe wächst mit dem Inhalt. Detail-Seiten mit
   Fill-Height-Content (.detail-body) gehören stattdessen in das DetailLayout. *@
<main class="page-shell">
    <SubpageNav />
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>
