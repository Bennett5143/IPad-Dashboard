@inherits LayoutComponentBase

@* Schlichter Shell für frei scrollende Seiten (NotFound, Admin): Inhalt mittig
   begrenzt, Höhe wächst mit dem Inhalt. Alle Unterseiten mit Fill-Height-Content
   (.detail-body) liegen im DetailLayout und navigieren über dessen Icon-Rail. *@
<main class="page-shell">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Ein unerwarteter Fehler ist aufgetreten.
    <a href="." class="reload">Neu laden</a>
    <span class="dismiss">🗙</span>
</div>
