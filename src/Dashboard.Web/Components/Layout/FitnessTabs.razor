@inject NavigationManager Nav

@* Sub-Navigation des Fitness-Bereichs. Sie sitzt zwischen Seitenkopf und Body — nicht in der
   Rail, damit die auf jeder Seite gleich hoch und still bleibt, und nicht im Body, weil sie dort
   mit dem Inhalt weggescrollt wäre. Das Tab-Vokabular (.tab-row/.tab) teilt sie sich mit der
   Wettbewerbs-Zeile auf /football; .area-subnav bringt nur den Innenabstand mit, den sie
   außerhalb des Bodys nicht mehr erbt.
   Aktiv-Markierung wird selbst berechnet, weil ein Tab auch seine Unterpfade abdecken muss
   (/whoop bleibt auf /whoop/connect aktiv) und Query-Parameter ignoriert gehören
   (/heatmap?place=…). *@
<nav class="tab-row area-subnav" aria-label="Fitness">
    <div class="tab-row-items">
        @foreach (var (href, label) in Area.Fitness)
        {
            var active = IsActive(href);
            <a class="tab @(active ? "is-active" : null)" href="@href"
               aria-current="@(active ? "page" : null)">@label</a>
        }
    </div>
</nav>

@code {
    private bool IsActive(string href)
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri);
        if (!path.StartsWith('/')) path = "/" + path;
        var cut = path.IndexOfAny(new[] { '?', '#' });
        if (cut >= 0) path = path[..cut];

        return path.Equals(href, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(href + "/", StringComparison.OrdinalIgnoreCase);
    }
}
