  "cards": [
    {
      "dot": "cyan",
      "title": "Layering",
      "items": [
        "Domain owns the ports (IWeatherProvider, IRunRepository) and carries no EF and no HTTP",
        "Infrastructure implements them; Web references both but names implementations only in Program.cs",
        "The Web project's GlobalUsings expose Dashboard.Domain.* and nothing else"
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistence",
      "items": [
        "Two contexts: DashboardDbContext and ResearchDbContext",
        "Spatial types via NetTopologySuite on PostGIS",
        "Twelve repositories and stores sit between the app and EF Core"
      ]
    },
    {
      "dot": "rose",
      "title": "External feeds",
      "items": [
        "Strava and Whoop hold user-delegated OAuth tokens in the database",
        "Public feeds: football-data.org, CoinGecko, alternative.me, OpenWeatherMap, HVV Geofox",
        "Map tiles and club crests are cached in named volumes"
      ]
    }
  ]
