<Project>
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- Coverage exclusions for generated code; see .runsettings. -->
    <RunSettingsFilePath>$(MSBuildThisFileDirectory).runsettings</RunSettingsFilePath>
    <!-- NuGetAudit: include transitive packages in advisory warnings (NU1901-NU1904). -->
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Reproducible restores: maintain packages.lock.json per project. CI restores
         run with locked mode; plain local restores update the lock files. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The RIDs the Docker build cross-compiles for. Keeps the RID-specific graphs
         in every lock file so the locked publish restore in the Dockerfile works. -->
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>